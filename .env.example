# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase.
# URL: Project Settings → Data API → Project URL
# Key: Project Settings → API Keys → Publishable key (sb_publishable_...)
# ¡Nunca uses la "secret key" aquí! Si lo dejas vacío, la app funciona en "modo local".
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
